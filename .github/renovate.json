{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":semanticPrefixFixDepsChoreOthers",
    ":ignoreModulesAndTests",
    "group:all",
    "workarounds:all",
    ":gitSignOff"
  ],
  "branchConcurrentLimit": 0,
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["replace", "toolchain", "go"],
      "enabled": false
    },
    {
      "matchPackageNames": ["github.com/aperturerobotics/starpc"],
      "enabled": false
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/libp2p/go-yamux/v5"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@chainsafe/libp2p-yamux"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@libp2p/interface"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "enabled": false
    },
    {
      "description": "Keep the Python packages on Python 3.11, which Spacewave's Python Resource requires.",
      "matchDepNames": ["python"],
      "allowedVersions": "<3.12"
    },
    {
      "description": "The Python protobuf runtime matches the protoc 6 that generates the _pb2 modules.",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["protobuf"],
      "allowedVersions": "<7"
    }
  ]
}
